# jira.cjs configuration — copy to `jira.env` (or `.env`) and fill in.
#
# The script loads the first file it finds, in this order:
#   1. $JIRA_ENV_FILE                       (explicit path override)
#   2. ./jira.env  or  ./.env               (current working directory)
#   3. ../.env relative to the script       (repo-root fallback when script is in a subdirectory)
#   4. ~/.config/jira/jira.env  or  ~/.jira.env   (global per-user config)
#
# For a standalone install, the simplest setup is ~/.config/jira/jira.env.

# ── Required ──────────────────────────────────────────────────────────────────
# Atlassian Cloud API token (create at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

# Your Jira Cloud site host (no https://, no trailing slash)
JIRA_HOST=your-site.atlassian.net

# The Atlassian account email the token belongs to
JIRA_EMAIL=you@example.com

# Default project key used by `open` (JQL filter) and `create`
JIRA_PROJECT=ABC

# ── Optional ──────────────────────────────────────────────────────────────────
# Numeric transition ID for "Done". If unset, `close` auto-resolves a transition
# whose destination is in the "Done" status category. Set this only if your
# workflow has multiple Done-category transitions and you want a specific one.
# JIRA_DONE_TRANSITION_ID=41
